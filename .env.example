# Copie este archivo a .env (no se versiona). Valores de ejemplo, NO reales.
# Cadena de conexión PostgreSQL (en Vercel la inyecta la integración Neon como DATABASE_URL).
DATABASE_URL=postgres://usuario:clave@localhost:5432/laparada
# Opcional: clave HMAC de sesiones. Si se omite, la API genera una aleatoria y la guarda en la BD.
SESSION_SECRET=
PORT=3000
